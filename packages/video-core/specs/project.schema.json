{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "video.project.json",
  "description": "專案層級定義與 scene 播放順序。scene 內容與狀態存於各自的 scene.json（SPEC §4.1）。",
  "type": "object",
  "$ref": "common.schema.json#/$defs/extensions",
  "unevaluatedProperties": false,
  "required": ["specVersion", "project", "scenes", "status", "updatedAt", "updatedBy"],
  "properties": {
    "$schema": { "type": "string" },
    "specVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "project": { "$ref": "#/$defs/project" },
    "scenes": {
      "description": "陣列順序即影片播放順序。",
      "type": "array",
      "items": { "$ref": "#/$defs/sceneRef" }
    },
    "status": { "$ref": "#/$defs/projectStatus" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedBy": { "$ref": "common.schema.json#/$defs/updatedBy" }
  },
  "allOf": [
    {
      "description": "分鏡產生後至少要有一個 scene。",
      "if": {
        "properties": { "status": { "enum": ["script_generated", "producing", "ready_to_assemble", "completed"] } }
      },
      "then": {
        "properties": { "scenes": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "music": {
      "description": "生成配樂的樂譜（SPEC §7.5）。`pnpm run music` 依此寫出 assets/music/bgm.wav；要當 BGM 使用，audio.bgm 設為該路徑。",
      "type": "object",
      "additionalProperties": false,
      "required": ["bpm", "key", "sections"],
      "properties": {
        "engine": {
          "description": "auto：有安裝 FluidSynth 與音色庫就用它（真實樂器取樣），否則用 webaudio（程式合成，免安裝）。",
          "enum": ["auto", "fluidsynth", "webaudio"],
          "default": "auto"
        },
        "style": {
          "description": "曲風模板，決定配器與鼓、鋼琴、貝斯的型態及旋律節奏：pop 輕快科技、warm 溫馨、fairytale 童話、suspense 懸疑科幻（預設無旋律）、anthem 激勵片尾、lofi 慵懶搖擺。",
          "enum": ["pop", "warm", "fairytale", "suspense", "anthem", "lofi"],
          "default": "pop"
        },
        "bpm": { "type": "integer", "minimum": 50, "maximum": 200 },
        "key": {
          "description": "調性，大調寫音名（C、F#、Bb），小調加 m（Am、C#m）。",
          "type": "string",
          "pattern": "^[A-G][#b]?m?$"
        },
        "seed": { "description": "旋律與力度的亂數種子；換一個數字就是另一版。", "type": "integer", "minimum": 0, "default": 1 },
        "drums": { "type": "boolean", "default": true },
        "instruments": {
          "description": "覆蓋曲風預設的 General MIDI 音色編號（0–127，只影響 fluidsynth）；null 表示不演奏該聲部。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lead": { "anyOf": [{ "$ref": "#/$defs/gmProgram" }, { "type": "null" }] },
            "keys": { "anyOf": [{ "$ref": "#/$defs/gmProgram" }, { "type": "null" }] },
            "pad": { "anyOf": [{ "$ref": "#/$defs/gmProgram" }, { "type": "null" }] },
            "bass": { "anyOf": [{ "$ref": "#/$defs/gmProgram" }, { "type": "null" }] }
          }
        },
        "soundfonts": {
          "description": "fluidsynth 各聲部使用的音色庫（~/.aoa/soundfonts/ 內的檔名，由 pnpm run music:setup 安裝）；未指定的聲部用 default，default 未指定時用 GeneralUser-GS.sf2。指定的檔案不存在時改用預設並警告。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": { "$ref": "#/$defs/soundfontName" },
            "lead": { "$ref": "#/$defs/soundfontName" },
            "keys": { "$ref": "#/$defs/soundfontName" },
            "pad": { "$ref": "#/$defs/soundfontName" },
            "bass": { "$ref": "#/$defs/soundfontName" },
            "drums": { "$ref": "#/$defs/soundfontName" }
          }
        },
        "mix": {
          "description": "各聲部音量增減（dB，0 為原始平衡）。兩種引擎都適用。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lead": { "$ref": "#/$defs/mixGain" },
            "keys": { "$ref": "#/$defs/mixGain" },
            "pad": { "$ref": "#/$defs/mixGain" },
            "bass": { "$ref": "#/$defs/mixGain" },
            "drums": { "$ref": "#/$defs/mixGain" }
          }
        },
        "sections": {
          "description": "依序演奏的段落。長度用 bars（小節數）或 scenes（對齊這些 scene 在成片中的總長，需已渲染）擇一指定。",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chords", "energy"],
            "oneOf": [{ "required": ["bars"] }, { "required": ["scenes"] }],
            "properties": {
              "name": { "type": "string", "maxLength": 40 },
              "bars": { "type": "integer", "minimum": 1, "maximum": 64 },
              "scenes": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.schema.json#/$defs/sceneId" }
              },
              "chords": {
                "description": "每小節一個和弦，不足時循環。例：C、Am、F#m、Bb、G7、Cmaj7、Dsus4。",
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": { "type": "string", "pattern": "^[A-G][#b]?(m|maj7|m7|7|sus2|sus4)?$" }
              },
              "energy": {
                "description": "0–1。<0.3 只有鋪底；0.3–0.6 加入鋼琴、貝斯與輕鼓；≥0.6 完整鼓組與旋律；≥0.85 旋律移高。進入能量較高的段落前會漸強、過門並加鈸。",
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "texture": {
                "description": "這段由哪些樂器演奏：full 全部（依 energy，預設）；piano 只有鋼琴；strings 只有弦樂鋪底；breakdown 抽掉鼓、貝斯只留長音；build 從鋪底與鋼琴開始，三分之一處加入貝斯與輕鼓，三分之二處全鼓組。旋律另計。",
                "enum": ["full", "piano", "strings", "breakdown", "build"],
                "default": "full"
              },
              "ending": { "description": "最後一小節收尾：延長主和弦、鼓只敲一下。", "type": "boolean" },
              "melody": {
                "description": "Agent 自己寫的旋律，取代自動旋律（不論 energy 都演奏）。每個音寫成 音名八度/時值：C5/4 四分音符、F#4/8 八分、Bb4/2. 附點二分、r/4 四分休止；| 分隔小節，每小節要剛好 4 拍；C4 為中央 C，音域 G3–G6。比段落短時循環。",
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    "gmProgram": { "type": "integer", "minimum": 0, "maximum": 127 },
    "soundfontName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.sf[23]$" },
    "mixGain": { "type": "number", "minimum": -24, "maximum": 12, "default": 0 },
    "projectStatus": {
      "description": "SPEC §4.5。",
      "enum": ["initialized", "analyzed", "designed", "script_generated", "producing", "ready_to_assemble", "completed", "failed"]
    },
    "sceneRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dir"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/sceneId" },
        "dir": {
          "description": "scene 目錄，格式 scenes/{三位數}-{slug}。目錄編號為建立時的序號，不代表目前順序。",
          "type": "string",
          "pattern": "^scenes/\\d{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "project": {
      "type": "object",
      "$ref": "common.schema.json#/$defs/extensions",
      "unevaluatedProperties": false,
      "required": ["id", "name", "sources", "language", "format", "tts"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": {
          "description": "影片類型：product = 產品介紹（Skill product-video）；story = 把故事做成 SVG 動畫影片（Skill story-video）。",
          "enum": ["product", "story"],
          "default": "product"
        },
        "sources": { "$ref": "#/$defs/sources" },
        "cast": {
          "description": "故事的角色與各自的聲音（kind 為 story 時使用）。script.md 中以【name】開頭的行由該角色說；其餘為旁白，用 project.tts。",
          "type": "array",
          "items": { "$ref": "#/$defs/castMember" }
        },
        "targetAudience": { "type": "string" },
        "durationAdjust": {
          "description": "製作中發現某段太趕時：auto = Agent 可自行在限度內調整 scene 長度並事後回報；ask = 每次先詢問使用者。",
          "enum": ["auto", "ask"],
          "default": "ask"
        },
        "customMotion": {
          "description": "自訂動畫（Agent 撰寫 visual.motion 動畫模組或繪製新的 SVG 插圖，會耗用較多 token）：allow = 全部放行；deny = 不使用；ask = 分鏡審閱時逐段由使用者決定。",
          "enum": ["allow", "deny", "ask"],
          "default": "ask"
        },
        "style": { "description": "影片風格與語氣（例如：專業簡報、活潑社群短片），與使用者確認後填寫。", "type": "string" },
        "language": { "$ref": "common.schema.json#/$defs/locale" },
        "translatedFrom": {
          "description": "由 /video-translate 產生時記錄來源專案（SPEC §4.4）。",
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "language"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "language": { "$ref": "common.schema.json#/$defs/locale" }
          }
        },
        "format": { "$ref": "#/$defs/format" },
        "audio": { "$ref": "#/$defs/audio" },
        "captions": { "$ref": "#/$defs/captions" },
        "tts": { "$ref": "#/$defs/tts" },
        "asr": { "$ref": "#/$defs/asr" }
      },
      "if": { "properties": { "kind": { "const": "story" } }, "required": ["kind"] },
      "then": {
        "description": "故事專案至少要有故事文字或點子描述。",
        "properties": {
          "sources": {
            "anyOf": [
              { "required": ["story"], "properties": { "story": { "type": "string", "minLength": 1 } } },
              { "required": ["description"], "properties": { "description": { "type": "string", "minLength": 1 } } }
            ]
          }
        }
      },
      "else": {
        "description": "產品專案至少要有一種產品來源。",
        "properties": {
          "sources": {
            "anyOf": [
              { "required": ["productUrl"], "properties": { "productUrl": { "type": "string" } } },
              { "required": ["sourceCodePath"], "properties": { "sourceCodePath": { "type": "string" } } },
              { "required": ["description"], "properties": { "description": { "type": "string", "minLength": 1 } } }
            ]
          }
        }
      }
    },
    "castMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "description": "英文小寫識別碼，也是美術資料夾名稱（@/assets/cast/<id>/）。", "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "name": { "description": "script.md 中【】內使用的名字。", "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^【】\\s]+$" },
        "description": { "description": "外型與個性，給畫圖與挑聲音參考。", "type": "string" },
        "provider": { "description": "省略時沿用 project.tts.provider。", "$ref": "common.schema.json#/$defs/ttsProvider" },
        "voice": { "description": "省略時沿用 project.tts.voice。", "type": "string", "minLength": 1 },
        "art": { "description": "角色部件 SVG 所在資料夾，通常為 @/assets/cast/<id>/。", "$ref": "common.schema.json#/$defs/relPath" }
      }
    },
    "sources": {
      "description": "影片的來源資料；至少要有哪些依 project.kind 而定。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https?://" },
        "requiresLogin": {
          "description": "產品網址要登入才看得到。為 true 時，使用者須先以 pnpm run login 在瀏覽器視窗自行登入，capture 才能執行（gate productLogin）。帳密不寫入任何檔案。",
          "type": "boolean",
          "default": false
        },
        "sourceCodePath": {
          "description": "產品原始碼位置，唯讀輸入，可在專案外（相對或絕對路徑）。",
          "type": ["string", "null"],
          "minLength": 1
        },
        "description": { "type": ["string", "null"] },
        "story": {
          "description": "故事全文、大綱或點子（kind 為 story 時使用）。整理後的定稿在 brief/story.md。",
          "type": ["string", "null"]
        },
        "referenceVideoUrl": {
          "description": "風格參考影片（可選，SPEC §6.2 Step 2）。",
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "format": {
      "description": "寬高須符合 aspectRatio（由 validate.mjs 檢查）。H.264 需偶數寬高。",
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectRatio", "width", "height", "fps"],
      "properties": {
        "aspectRatio": { "enum": ["16:9", "9:16", "1:1", "4:5"] },
        "width": { "type": "integer", "minimum": 320, "maximum": 3840, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 320, "maximum": 3840, "multipleOf": 2 },
        "fps": { "enum": [24, 25, 30, 50, 60] },
        "targetDurationSec": { "type": "number", "minimum": 5, "maximum": 600 }
      }
    },
    "audio": {
      "description": "BGM 設定，只在 assemble 階段使用（SPEC §7.5）。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bgm": {
          "description": "相對於專案根目錄；null 或檔案不存在時略過 BGM。",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/relPath" }, { "type": "null" }]
        },
        "bgmVolume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.25 },
        "ducking": { "type": "boolean", "default": true },
        "music": { "$ref": "#/$defs/music" }
      }
    },
    "captions": {
      "description": "字幕設定，只在 assemble 階段使用，不納入 scene 的 inputHash（SPEC §7.5）。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["srt", "burn", "none"], "default": "srt" },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontFamily": { "type": "string", "minLength": 1 },
            "fontSize": { "type": "integer", "minimum": 12, "maximum": 200 },
            "position": { "enum": ["bottom", "middle", "top"], "default": "bottom" }
          }
        }
      }
    },
    "tts": {
      "description": "專案預設 TTS（SPEC §7.4），scene 可覆寫。",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "$ref": "common.schema.json#/$defs/ttsProvider" },
        "voice": { "type": "string", "minLength": 1 },
        "pronunciation": {
          "description": "全域專有名詞發音校正對照表：{ \"原字/詞\": \"發音替換字或注音\" }，用以分離字幕與發音文本。",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "consent": {
          "description": "連網 TTS 的使用者同意紀錄。",
          "type": "object",
          "additionalProperties": false,
          "required": ["onlineTts"],
          "properties": {
            "onlineTts": { "type": "boolean" },
            "grantedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
          },
          "if": { "properties": { "onlineTts": { "const": true } } },
          "then": { "required": ["grantedAt"] }
        }
      },
      "if": {
        "properties": { "provider": { "not": { "enum": ["manual", "system"] } } }
      },
      "then": { "required": ["voice"] }
    },
    "asr": {
      "description": "ASR 語音辨識與發音校正設定。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["none", "qwen-asr", "whisper-cli", "faster-whisper", "openai", "fake"], "default": "none" },
        "model": {
          "description": "ASR 模型：依硬體預設推薦 Qwen/Qwen3-ASR-1.7B（具備 GPU）或 Qwen/Qwen3-ASR-0.6B（CPU/輕量環境）。",
          "enum": ["Qwen/Qwen3-ASR-1.7B", "Qwen/Qwen3-ASR-0.6B", "custom"],
          "default": "Qwen/Qwen3-ASR-0.6B"
        },
        "autoPatch": { "type": "boolean", "default": true },
        "consent": {
          "description": "本地 ASR 模型安裝或連網 ASR 的使用者同意紀錄。",
          "type": "object",
          "additionalProperties": false,
          "required": ["installAsr"],
          "properties": {
            "installAsr": { "type": "boolean" },
            "grantedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
          },
          "if": { "properties": { "installAsr": { "const": true } } },
          "then": { "required": ["grantedAt"] }
        }
      }
    }
  }
}
