{
  "name": "agent-video-platform",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "test:specs": "node --test packages/video-core/tests/specs.test.mjs apps/slide/tests/specs.test.mjs",
    "test": "node --test \"apps/*/tests/**/*.test.mjs\" \"packages/*/tests/**/*.test.mjs\" \"tests/**/*.test.mjs\" && node packages/video-core/tools/gen-types.mjs --check && node apps/slide/tools/gen-types.mjs --check",
    "test:template": "node --test \"packages/video-core/tests/template/*.test.mjs\"",
    "test:video": "node --test \"packages/video-core/tests/**/*.test.mjs\" \"apps/product/tests/**/*.test.mjs\" \"apps/story/tests/**/*.test.mjs\"",
    "test:slide": "node --test \"apps/slide/tests/**/*.test.mjs\"",
    "test:agent": "node --test \"packages/video-agent/tests/*.test.mjs\"",
    "build": "pnpm run build:web && node apps/product/tools/build-api.mjs && node apps/story/tools/build-api.mjs && node apps/slide/tools/build-api.mjs && node tools/build-platform-api.mjs",
    "dev": "vite --config apps/story/vite.config.ts",
    "dev:product": "vite --config apps/product/vite.config.ts",
    "dev:slide": "vite --config apps/slide/vite.config.ts",
    "dev:portal": "vite --config apps/portal/vite.config.ts",
    "build:web": "vite build --config apps/portal/vite.config.ts && vite build --config apps/story/vite.config.ts && vite build --config apps/product/vite.config.ts && vite build --config apps/slide/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p apps/portal/tsconfig.json && vue-tsc --noEmit -p apps/story/tsconfig.json && vue-tsc --noEmit -p apps/product/tsconfig.json && vue-tsc --noEmit -p apps/slide/tsconfig.json",
    "gen:types": "node packages/video-core/tools/gen-types.mjs && node apps/slide/tools/gen-types.mjs",
    "test:web": "node --test \"apps/product/tests/web/*.test.mjs\" \"apps/story/tests/web/*.test.mjs\" \"tests/site/*.test.mjs\""
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-json-patch": "^3.1.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "marked": "^18.0.14",
    "msedge-tts": "^2.0.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  }
}
