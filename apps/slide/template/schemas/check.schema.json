{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "check.schema.json",
  "title": "SlideCheck",
  "description": "output/check.json, written by `pnpm run check`: per-slide render findings and screenshots.",
  "type": "object",
  "required": ["checkedAt", "total", "ok", "slides", "errors"],
  "properties": {
    "checkedAt": { "type": "string", "format": "date-time" },
    "total": { "type": "integer", "minimum": 0 },
    "ok": { "type": "boolean" },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["no", "image", "issues"],
        "properties": {
          "no": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "line": { "type": "integer", "minimum": 1, "description": "Line in slides.md where the slide starts" },
          "image":{ "type": "string", "description": "Screenshot path relative to the project root" },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "message"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["overflow", "clipped", "unresolved", "image", "canvas", "compile", "runtime", "render"]
                },
                "message": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "errors": { "type": "array", "items": { "type": "string" }, "description": "Problems not tied to one slide, or that stopped the check" }
  },
  "additionalProperties": false
}
