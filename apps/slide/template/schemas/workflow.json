{
  "version": "1.0.0",
  "steps": [
    {
      "id": "init",
      "title": "初始化專案",
      "command": "/slide-init",
      "description": "下載並解壓 Slidev 範本，初始化 slides.md 與專案配置",
      "guide": "SKILL.md#init",
      "actions": [
        {
          "id": "unpack",
          "target": "project",
          "transitions": [
            {
              "to": "initialized"
            }
          ]
        }
      ]
    },
    {
      "id": "outline",
      "title": "大綱與分頁規劃",
      "command": "/slide-outline",
      "description": "依使用者提供的內容（slide.start.json 的 content 或對話中的說明）與受眾，規劃簡報結構、頁數、每頁核心資訊與視覺形式；不知道要講什麼就先問使用者，不沿用範本示範頁的主題",
      "checkpoint": true,
      "guide": "SKILL.md#outline",
      "actions": [
        {
          "id": "write_outline",
          "target": "project",
          "transitions": [
            {
              "from": [
                "initialized"
              ],
              "to": "outlined"
            }
          ]
        }
      ]
    },
    {
      "id": "draft",
      "title": "撰寫簡報文案",
      "command": "/slide-draft",
      "description": "編寫 slides.md 各頁內文、標題、講者備忘錄，選配 Slidev 原生 layout 版型",
      "checkpoint": true,
      "guide": "SKILL.md#draft",
      "actions": [
        {
          "id": "write_slides",
          "target": "project",
          "transitions": [
            {
              "from": [
                "outlined"
              ],
              "to": "drafted"
            }
          ]
        }
      ]
    },
    {
      "id": "visual",
      "title": "視覺圖表與 3D 注入",
      "command": "/slide-visual",
      "description": "在簡報中繪製 SVG 向量架構圖、流程圖、Iconify 圖示，並適度嵌入 Three.js / WebGL 3D 組件",
      "checkpoint": true,
      "guide": "visual-guide.md",
      "actions": [
        {
          "id": "enhance_visuals",
          "target": "project",
          "transitions": [
            {
              "from": [
                "drafted"
              ],
              "to": "visualized"
            }
          ]
        }
      ]
    },
    {
      "id": "export",
      "title": "匯出簡報",
      "command": "/slide-export",
      "description": "調用 Slidev CLI 匯出向量 PDF (output/slides.pdf) 與單檔網頁簡報 (dist/index.html)；使用者要求時另匯出 PowerPoint",
      "guide": "export-guide.md",
      "actions": [
        {
          "id": "export_pdf",
          "target": "project",
          "transitions": [
            {
              "from": [
                "visualized",
                "drafted"
              ],
              "to": "exported"
            }
          ]
        }
      ]
    }
  ]
}
